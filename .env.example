# SPDX-License-Identifier: AGPL-3.0-only
# Keys are read from the environment, never from the config file. Copy this to .env and
# fill it in. .env is gitignored, and it is the file that holds the caller api key too when
# the gate is on. A .env should have 600 permissions.

EXAMPLE_API_KEY_1=
EXAMPLE_API_KEY_2=
LOCAL_KEY=

# Optional: the api key callers present, only read when auth.api_key_env names it. Use a name
# this project owns, as below. A bare API_KEY can be exported by another program in the same
# shell or in a shared .env, and then the gate is on with a value this project did not choose.
# PlainROUTE_API_KEY=

# Optional: where the binary looks for the config file when -config is not given.
PLAINROUTE_CONFIG=config.yaml
